{
  "name": "macpherson-ventures",
  "main": "src/worker.js",
  "compatibility_date": "2026-02-16",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/unsubscribe",
      "/unsubscribe/",
      "/api/*",
      "/assets/email/*"
    ]
  },
  // Create the KV namespaces (needs a logged-in wrangler session), then
  // fill in "id" and "preview_id" below. wrangler dev works without them.
  //   npx wrangler kv namespace create OPTOUTS
  //   npx wrangler kv namespace create OPTOUTS --preview
  "kv_namespaces": [
    {
      "binding": "OPTOUTS"
    }
  ]
}
